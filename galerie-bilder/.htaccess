# Upload-Ordner: nur Bilder ausliefern, niemals Code ausführen.
php_flag engine off
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .phps .cgi .pl .py .sh .htaccess

<FilesMatch "\.(php|phtml|php[0-9]|phps|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(jpe?g|png|webp|gif)$">
  Require all granted
</FilesMatch>

Options -ExecCGI -Indexes
